<div class='dnd5e2 chat-card ammo-refund-notice-card'>
    <section class='card-header description collapsible'>
        <header class='summary'>
            <img class='gold-icon' src='{{item.img}}' alt='{{item.name}}' />
            <div class='name-stacked border'>
                <span class='title'>{{title}}</span>
            </div>
            <i class='fa-solid fa-chevron-down fa-fw' inert></i>
        </header>
        <section class='details collapsible-content card-content'>
            <div class='wrapper'>
                <p class='title'><em>{{{description}}}</em></p>
            </div>
        </section>
    </section>
</div>