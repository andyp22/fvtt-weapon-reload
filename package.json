{
    "name": "fvtt-weapon-reload",
    "version": "0.1.0",
    "description": "Weapon Reload",
    "private": true,
    "scripts": {
        "build": "npm run clean && npm run prettier:format && npm run rolldown:build && npm run types",
        "clean": "rimraf dist",
        "prettier:check": "prettier \"**/*.{js,json,md,mdx,ts,tsx,scss,css}\" --check",
        "prettier:format": "prettier \"**/*.{js,json,md,mdx,ts,tsx,scss,css}\" --write --list-different --no-error-on-unmatched-pattern",
        "types": "tsc --emitDeclarationOnly",
        "rolldown:build": "rolldown --config ./configs/rolldown.config.mjs",
        "rolldown:watch": "rolldown --config ./configs/rolldown.config.mjs --watch"
    },
    "repository": {},
    "author": "andyp22",
    "license": "MIT",
    "devDependencies": {
        "@league-of-foundry-developers/foundry-vtt-dnd5e-types": "^1.2.4-2",
        "@league-of-foundry-developers/foundry-vtt-types": "^12.331.5",
        "@typescript-eslint/eslint-plugin": "^8.1.0",
        "@typescript-eslint/parser": "^8.1.0",
        "eslint": "^9.9.0",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.5.3",
        "rimraf": "^5.0.0",
        "rolldown": "^1.0.0-beta.1",
        "typescript": "^5.5.4"
    }
}
